{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/engines/schema/render.schema.json",
  "title": "Render Spec v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "fps",
    "width",
    "height",
    "durationInFrames",
    "durationSec",
    "segments",
    "background"
  ],
  "properties": {
    "version": { "const": "render_spec_v2" },
    "fps": { "type": "integer", "minimum": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "durationInFrames": { "type": "integer", "minimum": 1 },
    "durationSec": { "type": "number", "exclusiveMinimum": 0 },
    "background": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "bgm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "loop": { "type": "boolean" }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "time", "role", "start", "end", "audioSrc", "scene_assets"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "time": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "audioSrc": { "type": "string", "minLength": 1 },
          "text_position_preset": {
            "type": "string",
            "enum": ["logboard_center"]
          },
          "text_offset_y": { "type": "integer" },
          "scene_assets": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "background": { "type": "string" },
              "slide": { "type": "string" },
              "monolith": { "type": "string" },
              "dialog_box": { "type": "string" },
              "character_left": { "type": "string" },
              "character_right": { "type": "string" },
              "hook_background": { "type": "string" },
              "hook_character": { "type": "string" },
              "hook_bubble": { "type": "string" }
            }
          },
          "lip_sync": {
            "type": "object",
            "additionalProperties": true,
            "required": ["enabled", "interval_ms", "frames"],
            "properties": {
              "enabled": { "type": "boolean" },
              "mode": { "type": "string", "enum": ["scene", "hook"] },
              "reason": { "type": "string" },
              "interval_ms": { "type": "integer", "minimum": 1 },
              "frames": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "mute_non_speaking_side_to_idle": { "type": "boolean" },
              "speaker": { "type": "string" },
              "speaker_side": {
                "type": "string",
                "enum": ["left", "right", "hook", "none"]
              },
              "assets": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "left": { "$ref": "#/$defs/assetStateSet" },
                  "right": { "$ref": "#/$defs/assetStateSet" },
                  "hook": { "$ref": "#/$defs/assetStateSet" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "assetStateSet": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": {
        "idle": { "type": "string" },
        "mouth_closed": { "type": "string" },
        "mouth_half": { "type": "string" },
        "mouth_open": { "type": "string" },
        "frozen": { "type": "string" }
      }
    }
  }
}
