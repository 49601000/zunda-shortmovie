{
  "meta": {
    "version": "scene_player_sot_v1",
    "created_by": "mock/scene-player-mock-v1.html",
    "description": "Scene Player Mock v1 のキャラ配置・表示運用・scene定義のSOT"
  },
  "canvas": {
    "width": 1080,
    "height": 1920,
    "aspect_ratio": "9:16"
  },
  "layout": {
    "background": {
      "z_index": 1,
      "fit": "cover"
    },
    "monolith": {
      "x": 72,
      "y": 72,
      "width": 936,
      "height": 132,
      "z_index": 25
    },
    "slide_area": {
      "x": 57,
      "y": 184,
      "width": 966,
      "height": 1118,
      "z_index": 20
    },
    "characters": {
      "base": {
        "width": 224,
        "height": 736,
        "z_index": 12
      },
      "left": {
        "x_mode": "left",
        "x": -100,
        "bottom": -250
      },
      "right": {
        "x_mode": "right",
        "x": 102,
        "bottom": -190
      }
    },
    "dialog_box": {
      "left": 54,
      "right": 54,
      "bottom": 58,
      "height": 330,
      "z_index": 30
    }
  },
  "character_operation": {
    "engine_to_character_asset": {
      "metan_engine": "metan",
      "zundamon_engine": "zundamon"
    },
    "state_mapping": {
      "speaking": "mouth_closed",
      "grayscale_frozen": "frozen",
      "idle": "idle"
    },
    "framing_defaults": {
      "left": {
        "scale": 2.75,
        "anchor": "bottom-left",
        "xOffset": -96,
        "allowCrop": false
      },
      "right": {
        "scale": 3.0,
        "anchor": "bottom-left",
        "xOffset": -96,
        "allowCrop": false
      }
    },
    "static_asset_state_rules": {
      "default": {
        "left": "idle",
        "right": "idle"
      },
      "speaker_active_state": "mouth_closed",
      "ai_scene": {
        "left": "frozen",
        "right": "frozen"
      }
    },
    "lip_sync": {
      "enabled_default": true,
      "interval_ms": 210,
      "frames": [
        "mouth_closed",
        "mouth_half",
        "mouth_open",
        "mouth_half",
        "mouth_closed"
      ],
      "supported_speakers": [
        "metan_engine",
        "zundamon_engine"
      ],
      "disabled_on_ai_scene": true,
      "mute_non_speaking_side_to_idle": true
    },
    "ai_scene_detection": {
      "role_equals": [
        "roast"
      ],
      "event_equals": [
        "ai_trigger"
      ]
    }
  },
  "scene_rules": {
    "ai_scene_requires": {
      "composition.monolith.mode": "sound_only",
      "composition.monolith.display_text": "SOUND ONLY",
      "required_effects": [
        "grayscale_characters",
        "darken_slide"
      ]
    },
    "normal_scene_requires": {
      "composition.monolith.mode": "silent_black",
      "effects": []
    }
  },
  "asset_registry": {
    "backgrounds": {
      "classroom_day": "backgrounds/classroom-daytime.png",
      "classroom-daytime": "backgrounds/classroom-daytime.png",
      "classroom_evening": "backgrounds/classroom-evening.png",
      "classroom-evening": "backgrounds/classroom-evening.png",
      "classroom_evening2": "backgrounds/classroom-evening2.png",
      "classroom-evening2": "backgrounds/classroom-evening2.png"
    },
    "characters": {
      "metan": {
        "idle": "characters/metan/metan-0.png",
        "mouth_closed": "characters/metan/metan-1.png",
        "mouth_half": "characters/metan/metan-0.png",
        "mouth_open": "characters/metan/metan-2.png",
        "frozen": "characters/metan/metan-2.png"
      },
      "zundamon": {
        "idle": "characters/zundamon/zundamon-normal-0001.png",
        "mouth_closed": "characters/zundamon/zundamon-normal-0000.png",
        "mouth_half": "characters/zundamon/zundamon-normal-0001.png",
        "mouth_open": "characters/zundamon/zundamon-normal-0002.png",
        "frozen": "characters/zundamon/zundamon-normal-0001.png"
      }
    },
    "slides": {
      "slide_hook": "slide/000/001.png",
      "slide_misunderstanding": "slide/000/001.png",
      "slide_explanation": "slide/000/002.png",
      "slide_roast": "slide/000/002.png",
      "slide_collapse": "slide/000/003.png"
    },
    "monolith": {
      "silent_black": "monolith/monolith-0.png",
      "sound_only": "monolith/monolith-1.png"
    },
    "ui": {
      "dialog_box": "logboard/logboard-BK.png"
    }
  },
  "scenes": [
    {
