{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schema/script.schema.json",
  "title": "Script Spec v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "source_spec", "settings", "script", "hook_variants", "render_hints"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "created_by"],
      "properties": {
        "version": { "const": "script_forge_v2" },
        "created_by": { "type": "string", "minLength": 1 }
      }
    },
    "source_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metaphor_spec"],
      "properties": {
        "metaphor_spec": { "type": "object" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "target_duration_sec",
        "max_duration_sec",
        "structure_mode",
        "roast_ai",
        "one_video_one_insight"
      ],
      "properties": {
        "target_duration_sec": { "type": "integer", "minimum": 1 },
        "max_duration_sec": { "type": "integer", "minimum": 1, "maximum": 30 },
        "structure_mode": { "type": "string", "minLength": 1 },
        "roast_ai": {
          "type": "string",
          "enum": ["gpt_roast", "claude_roast", "grok_roast", "gemini_roast"]
        },
        "one_video_one_insight": { "type": "boolean" }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "topic", "segments"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "segments": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "time", "role", "speaker", "screen_text", "voice", "event"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "time": { "type": "string", "minLength": 1 },
              "role": {
                "type": "string",
                "enum": ["hook", "misunderstanding", "explanation", "roast", "collapse"]
              },
              "speaker": { "type": "string", "minLength": 1 },
              "screen_text": { "type": "string", "minLength": 1 },
              "voice": { "type": "string", "minLength": 1 },
              "event": { "type": "string", "minLength": 1 },
              "monolith": {
                "type": "object",
                "required": ["mode", "display_text"],
                "properties": {
                  "mode": { "type": "string" },
                  "display_text": { "type": "string" }
                }
              },
              "effects": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "role": { "const": "roast" } },
                  "required": ["role"]
                },
                "then": {
                  "required": ["monolith", "effects"],
                  "properties": {
                    "event": { "const": "ai_trigger" },
                    "monolith": {
                      "required": ["mode", "display_text"],
                      "properties": {
                        "mode": { "const": "sound_only" },
                        "display_text": { "const": "SOUND ONLY" }
                      }
                    },
                    "effects": {
                      "type": "array",
                      "allOf": [
                        { "contains": { "const": "grayscale_characters" } },
                        { "contains": { "const": "darken_slide" } },
                        { "contains": { "const": "slight_flicker" } }
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "event": { "const": "normal" }
                  }
                }
              }
            ]
          },
          "allOf": [
            { "contains": { "type": "object", "properties": { "role": { "const": "hook" } }, "required": ["role"] } },
            { "contains": { "type": "object", "properties": { "role": { "const": "misunderstanding" } }, "required": ["role"] } },
            { "contains": { "type": "object", "properties": { "role": { "const": "explanation" } }, "required": ["role"] } },
            { "contains": { "type": "object", "properties": { "role": { "const": "roast" } }, "required": ["role"] } },
            { "contains": { "type": "object", "properties": { "role": { "const": "collapse" } }, "required": ["role"] } }
          ]
        }
      }
    },
    "hook_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "render_hints": {
      "type": "object",
      "additionalProperties": true,
      "required": ["layout", "background", "monolith_default", "dialog_style", "characters"],
      "properties": {
        "layout": { "type": "string", "minLength": 1 },
        "background": { "type": "string", "minLength": 1 },
        "monolith_default": { "type": "string", "minLength": 1 },
        "dialog_style": { "type": "string", "minLength": 1 },
        "characters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": { "type": "string", "minLength": 1 },
            "right": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
