{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schema/scene-render.schema.json",
  "title": "Scene Render Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "source_spec", "settings", "scenes", "render_control"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "created_by"],
      "properties": {
        "version": { "const": "scene_renderer_v1" },
        "created_by": { "type": "string", "minLength": 1 }
      }
    },
    "source_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialogue_rendered"],
      "properties": {
        "dialogue_rendered": { "type": "object" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "resolution", "layout", "background", "dialog_style"],
      "properties": {
        "format": { "const": "vertical_9_16" },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "const": 1080 },
            "height": { "const": 1920 }
          }
        },
        "layout": { "const": "classroom_monolith_slide_dialog" },
        "background": { "const": "classroom_day" },
        "dialog_style": { "const": "visual_novel_translucent_black" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_dialogue_id",
          "source_segment_id",
          "time",
          "role",
          "speaker",
          "dialog",
          "composition",
          "effects"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_dialogue_id": { "type": "string", "minLength": 1 },
          "source_segment_id": { "type": "string", "minLength": 1 },
          "time": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": ["hook", "misunderstanding", "explanation", "roast", "collapse"]
          },
          "speaker": { "type": "string", "minLength": 1 },
          "text_position_preset": {
            "type": "string",
            "enum": ["logboard_center"]
          },
          "text_offset_y": { "type": "integer" },
          "dialog": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speaker_name", "speaker_color", "screen_text", "voice"],
            "properties": {
              "speaker_name": { "type": "string", "minLength": 1 },
              "speaker_color": { "type": "string", "minLength": 1 },
              "screen_text": { "type": "string", "minLength": 1 },
              "voice": { "type": "string", "minLength": 1 }
            }
          },
          "composition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["background", "monolith", "slide_area", "characters", "dialog_box"],
            "properties": {
              "background": {
                "type": "object",
                "additionalProperties": false,
                "required": ["asset_id", "fit"],
                "properties": {
                  "asset_id": { "const": "classroom_day" },
                  "fit": { "const": "cover" }
                }
              },
              "monolith": {
                "type": "object",
                "additionalProperties": false,
                "required": ["asset_id", "mode", "display_text", "position"],
                "properties": {
                  "asset_id": { "type": "string", "minLength": 1 },
                  "mode": { "type": "string", "enum": ["silent_black", "sound_only"] },
                  "display_text": { "type": "string" },
                  "position": { "const": "top_center" }
                }
              },
              "slide_area": {
                "type": "object",
                "additionalProperties": false,
                "required": ["visible", "style", "position", "content_ref", "state"],
                "properties": {
                  "visible": { "type": "boolean" },
                  "style": { "const": "off_white_card" },
                  "position": { "const": "center" },
                  "content_ref": { "type": "string", "minLength": 1 },
                  "state": { "type": "string", "enum": ["normal", "darkened"] }
                }
              },
              "characters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["left", "right"],
                "properties": {
                  "left": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["engine", "asset_id", "visible", "position", "state"],
                    "properties": {
                      "engine": { "const": "metan_engine" },
                      "asset_id": { "const": "metan" },
                      "visible": { "type": "boolean" },
                      "position": { "const": "bottom_left" },
                      "state": { "type": "string", "enum": ["idle", "speaking", "grayscale_frozen"] }
                    }
                  },
                  "right": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["engine", "asset_id", "visible", "position", "state"],
                    "properties": {
                      "engine": { "const": "zundamon_engine" },
                      "asset_id": { "const": "zundamon" },
                      "visible": { "type": "boolean" },
                      "position": { "const": "bottom_right" },
                      "state": { "type": "string", "enum": ["idle", "speaking", "grayscale_frozen"] }
                    }
                  }
                }
              },
              "dialog_box": {
                "type": "object",
                "additionalProperties": false,
                "required": ["asset_id", "visible", "position", "speaker_color"],
                "properties": {
                  "asset_id": { "const": "dialog_box_translucent_black" },
                  "visible": { "type": "boolean" },
                  "position": { "const": "bottom" },
                  "speaker_color": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "effects": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                { "properties": { "role": { "const": "roast" } }, "required": ["role"] },
                { "properties": { "speaker": { "enum": ["gpt_roast", "claude_roast", "grok_roast", "gemini_roast"] } }, "required": ["speaker"] }
              ]
            },
            "then": {
              "properties": {
                "composition": {
                  "properties": {
                    "monolith": {
                      "properties": {
                        "mode": { "const": "sound_only" },
                        "display_text": { "const": "SOUND ONLY" }
                      }
                    },
                    "slide_area": {
                      "properties": {
                        "state": { "const": "darkened" }
                      }
                    },
                    "characters": {
                      "properties": {
                        "left": { "properties": { "state": { "const": "grayscale_frozen" } } },
                        "right": { "properties": { "state": { "const": "grayscale_frozen" } } }
                      }
                    }
                  }
                },
                "effects": {
                  "type": "array",
                  "allOf": [
                    { "contains": { "const": "grayscale_characters" } },
                    { "contains": { "const": "darken_slide" } },
                    { "contains": { "const": "slight_flicker" } }
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "composition": {
                  "properties": {
                    "monolith": {
                      "properties": {
                        "mode": { "const": "silent_black" },
                        "display_text": { "const": "" }
                      }
                    },
                    "slide_area": {
                      "properties": {
                        "state": { "const": "normal" }
                      }
                    }
                  }
                },
                "effects": {
                  "type": "array",
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "render_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook_enabled", "default_scene_visibility_policy", "scene_visibility"],
      "properties": {
        "hook_enabled": { "type": "boolean" },
        "default_scene_visibility_policy": {
          "type": "string",
          "minLength": 1
        },
        "scene_visibility": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    }
  }
}
