{
  "project_id": "0002",
  "version": "v01",
  "hook": {
    "id": "hook_a",
    "text": "ずんだもん、その理解で本当に合ってる？",
    "intent": "疑問型",
    "duration_sec": 2
  },
  "slides": [
    {
      "slide_id": "slide_01",
      "role": "title",
      "title": "正常性バイアス",
      "body": "人は危険な状況でも『まだ大丈夫』と思い込みやすい",
      "visual_intent": "simple_diagram: 危険→『大丈夫』→行動しない / core_message: 人は危険な状況でも『まだ大丈夫』と思い込みやすい",
      "simple_diagram": "危険→『大丈夫』→行動しない"
    },
    {
      "slide_id": "slide_02",
      "role": "concept",
      "title": "なぜ起こる？",
      "body": "不安な現実を受け入れたくないため、問題を小さく考えてしまう",
      "visual_intent": "simple_diagram: 問題発生→『まだ平気』→対策しない→問題拡大 / core_message: 不安な現実を受け入れたくないため、問題を小さく考えてしまう",
      "simple_diagram": "問題発生→『まだ平気』→対策しない→問題拡大"
    },
    {
      "slide_id": "slide_03",
      "role": "example",
      "title": "身近な例",
      "body": "お金がほとんど無いのに『なんとかなる』と思い込む",
      "visual_intent": "simple_diagram: 残金300円→『まだ大丈夫』→何もしない→生活が苦しくなる / core_message: お金がほとんど無いのに『なんとかなる』と思い込む",
      "simple_diagram": "残金300円→『まだ大丈夫』→何もしない→生活が苦しくなる"
    }
  ],
