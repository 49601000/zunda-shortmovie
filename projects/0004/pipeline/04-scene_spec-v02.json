  "scenes": [
    {
      "scene_id": "scene_001",
      "slide_id": "slide_01",
      "speaker": "ずんだもん",
      "text": "あと500円買わないと送料500円がかかるのだ！",
      "emotion": "excited",
      "duration_sec": 3.87
    },
    {
      "scene_id": "scene_002",
      "slide_id": "slide_01",
      "speaker": "めたん",
      "text": "じゃあ送料払えばいいじゃない",
      "emotion": "neutral",
      "duration_sec": 2.26
    },
    {
      "scene_id": "scene_003",
      "slide_id": "slide_01",
      "speaker": "ずんだもん",
      "text": "何を言ってるのだ！？ 500円払うくらいならうまい棒50本買うのだ！",
      "emotion": "excited",
      "duration_sec": 5.48
    },
    {
      "scene_id": "scene_004",
      "slide_id": "slide_01",
      "speaker": "めたん",
      "text": "それ500円以上使ってるわよ",
      "emotion": "neutral",
      "duration_sec": 2.26
    },
    {
      "scene_id": "scene_005",
      "slide_id": "slide_02",
      "speaker": "ずんだもん",
      "text": "うまい棒は残るのだ！送料は何も残らないのだ！",
      "emotion": "excited",
      "duration_sec": 3.55
    },
    {
      "scene_id": "scene_006",
      "slide_id": "slide_02",
      "speaker": "めたん",
      "text": "人は得する喜びより、損する痛みを強く感じるの。これを損失回避バイアスって言うのよ",
      "emotion": "neutral",
      "duration_sec": 6
    },
    {
      "scene_id": "scene_007",
      "slide_id": "slide_02",
      "speaker": "ずんだもん",
      "text": "でも送料500円は損なのだ！",
      "emotion": "excited",
      "duration_sec": 2.26
    },
    {
      "scene_id": "scene_008",
      "slide_id": "slide_03",
      "speaker": "めたん",
      "text": "その感覚のせいで余計な物を買うのよ",
      "emotion": "neutral",
      "duration_sec": 2.74
    },
    {
      "scene_id": "scene_009",
      "slide_id": "slide_03",
      "speaker": "ずんだもん",
      "text": "じゃあ、めたんが送料を払って、うまい棒はボクがもらうのだ！",
      "emotion": "excited",
      "duration_sec": 4.68
    },
    {
      "scene_id": "scene_010",
      "slide_id": "slide_03",
      "speaker": "めたん",
      "text": "ただの強盗じゃないの",
      "emotion": "neutral",
      "duration_sec": 1.61
    }
  ]
}
