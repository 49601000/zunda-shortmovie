  "slides": [
    {
      "slide_id": "slide_01",
      "role": "title",
      "title": "損失回避バイアス",
      "body": "人は『得する』より『損したくない』を強く感じる",
      "visual_intent": "simple_diagram: 得する😊 ←→ 損する😣（損の方を大きく描く） / core_message: 人は『得する』より『損したくない』を強く感じる",
      "simple_diagram": "得する😊 ←→ 損する😣（損の方を大きく描く）"
    },
    {
      "slide_id": "slide_02",
      "role": "concept",
      "title": "なぜ起こる？",
      "body": "送料を払う損を避けようとして、不要な物を買ってしまう",
      "visual_intent": "simple_diagram: 送料500円→嫌 → 追加購入500円以上 → 出費増加 / core_message: 送料を払う損を避けようとして、不要な物を買ってしまう",
      "simple_diagram": "送料500円→嫌 → 追加購入500円以上 → 出費増加"
    },
    {
      "slide_id": "slide_03",
      "role": "example",
      "title": "ネット通販のあるある",
      "body": "『あと1品で送料無料』で予定外の買い物をしてしまう",
      "visual_intent": "simple_diagram: 商品購入 → あと500円で送料無料 → 不要な商品追加 / core_message: 『あと1品で送料無料』で予定外の買い物をしてしまう",
      "simple_diagram": "商品購入 → あと500円で送料無料 → 不要な商品追加"
    }
  ],
