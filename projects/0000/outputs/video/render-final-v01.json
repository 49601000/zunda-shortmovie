    "id": "hook_a",
    "text": "ずんだもん、その理解で本当に合ってる？",
    "intent": "疑問型",
    "duration_sec": 2
  },
  "slides": [
    {
      "slide_id": "slide_01",
      "role": "title",
      "title": "認知的不協和",
      "body": "考えと現実がぶつかるとモヤモヤが生まれる",
      "visual_intent": "simple_diagram: 『自分は正しい』⇔『失敗した』の対立 / core_message: 考えと現実がぶつかるとモヤモヤが生まれる / teacher_note: 認知的不協和は心の中の矛盾による不快感",
      "teacher_note": "認知的不協和は心の中の矛盾による不快感",
      "simple_diagram": "『自分は正しい』⇔『失敗した』の対立"
    },
    {
      "slide_id": "slide_02",
      "role": "concept",
      "title": "なぜ言い訳するの？",
      "body": "失敗した自分を認めたくないため",
      "visual_intent": "simple_diagram: 失敗 → モヤモヤ → 言い訳 → 気持ちが楽 / core_message: 失敗した自分を認めたくないため / teacher_note: 現実を変えるより考え方を変えて不快感を減らそうとする",
      "teacher_note": "現実を変えるより考え方を変えて不快感を減らそうとする",
      "simple_diagram": "失敗 → モヤモヤ → 言い訳 → 気持ちが楽"
    },
    {
      "slide_id": "slide_03",
      "role": "example",
      "title": "ゲーム課金の例",
      "body": "つまらなくても『いつか面白くなる』と考えてしまう",
      "visual_intent": "simple_diagram: 課金 → つまらない → 『将来神ゲー』 / core_message: つまらなくても『いつか面白くなる』と考えてしまう / teacher_note: 損した事実より自分の選択を守ろうとしている",
      "teacher_note": "損した事実より自分の選択を守ろうとしている",
      "simple_diagram": "課金 → つまらない → 『将来神ゲー』"
    }
  ],
