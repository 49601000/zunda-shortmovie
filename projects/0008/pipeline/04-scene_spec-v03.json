{
  "project_id": "0008",
  "source": "raw_conversation-v04.txt",
  "scenes": [
    {
      "scene_id": "scene_001",
      "slide_id": "slide_01",
      "speaker": "ずんだもん",
      "text": "1000ゲームもハマってるんだから、そろそろ来るはずなのだ！",
      "emotion": "excited",
      "duration_sec": 4.84
    },
    {
      "scene_id": "scene_002",
      "slide_id": "slide_01",
      "speaker": "めたん",
      "text": "それ、典型的なギャンブラーの誤謬よ。どんなにハマっても抽選確率は同じよ",
      "emotion": "neutral",
      "duration_sec": 5.65
    },
    {
      "scene_id": "scene_003",
      "slide_id": "slide_01",
      "speaker": "ずんだもん",
      "text": "そんなわけないのだ！この台はもう限界までパワーを溜めてるのだ！",
      "emotion": "excited",
      "duration_sec": 5
    },
    {
      "scene_id": "scene_004",
      "slide_id": "slide_02",
      "speaker": "めたん",
      "text": "台はただの機械よ。オカルトなエネルギーなんて溜まってないわ",
      "emotion": "neutral",
      "duration_sec": 4.68
    },
    {
      "scene_id": "scene_005",
      "slide_id": "slide_02",
      "speaker": "ずんだもん",
      "text": "ああっ、隣の奴が急に当たり始めたのだ！ボクの分の運が吸い取られてるのだ！",
      "emotion": "excited",
      "duration_sec": 5.81
    },
    {
      "scene_id": "scene_006",
      "slide_id": "slide_02",
      "speaker": "めたん",
      "text": "オカルトから被害妄想にシフトしたわね",
      "emotion": "neutral",
      "duration_sec": 2.9
    },
    {
      "scene_id": "scene_007",
      "slide_id": "slide_03",
      "speaker": "ずんだもん",
      "text": "軍資金が尽きたのだ……めたん、ボクの輝かしい大逆転劇のために、ちょっと栄一を貸すのだ！",
      "emotion": "excited",
      "duration_sec": 6
    },
    {
      "scene_id": "scene_008",
      "slide_id": "slide_03",
      "speaker": "めたん",
      "text": "その目はもう、ただの養分の目よ。さあ、お家に帰るわよ",
      "emotion": "neutral",
      "duration_sec": 4.19
    },
    {
      "scene_id": "scene_009",
      "slide_id": "slide_03",
      "speaker": "speaker",
      "text": "これでもええやろｗ",
      "emotion": "neutral",
      "duration_sec": 1.6
    }
  ]
}
