  "hook": {
    "id": "hook_a",
    "text": "ずんだもん、その理解で本当に合ってる？",
    "intent": "疑問型",
    "duration_sec": 2
  },
  "slides": [
    {
      "slide_id": "slide_01",
      "role": "title",
      "title": "スポットライト効果",
      "body": "人は自分が思うほど他人から見られていない",
      "visual_intent": "simple_diagram: 自分←大きなスポットライト→周囲の人 / core_message: 人は自分が思うほど他人から見られていない",
      "simple_diagram": "自分←大きなスポットライト→周囲の人"
    },
    {
      "slide_id": "slide_02",
      "role": "concept",
      "title": "なぜ起きる？",
      "body": "自分の失敗や見た目を他人も強く気にしていると思い込む",
      "visual_intent": "simple_diagram: 寝癖・失敗→『みんな見てる』→実際『みんな自分のことで忙しい』 / core_message: 自分の失敗や見た目を他人も強く気にしていると思い込む",
      "simple_diagram": "寝癖・失敗→『みんな見てる』→実際『みんな自分のことで忙しい』"
    },
    {
      "slide_id": "slide_03",
      "role": "example",
      "title": "身近な例",
      "body": "寝癖や言い間違いをしても、多くの人はすぐ忘れてしまう",
      "visual_intent": "simple_diagram: 自分『やばい！』→周囲Aスマホ 周囲B勉強 周囲C晩ご飯 / core_message: 寝癖や言い間違いをしても、多くの人はすぐ忘れてしまう",
      "simple_diagram": "自分『やばい！』→周囲Aスマホ 周囲B勉強 周囲C晩ご飯"
    }
  ],
