  "hook": {
    "id": "hook_a",
    "text": "ずんだもん、その理解で本当に合ってる？",
    "intent": "疑問型",
    "duration_sec": 2
  },
  "slides": [
    {
      "slide_id": "slide_01",
      "role": "title",
      "title": "確証バイアス",
      "body": "自分の考えを支持する情報ばかり信じてしまう",
      "visual_intent": "simple_diagram: 『思い込み』→『都合の良い情報だけ集める』 / core_message: 自分の考えを支持する情報ばかり信じてしまう",
      "simple_diagram": "『思い込み』→『都合の良い情報だけ集める』"
    },
    {
      "slide_id": "slide_02",
      "role": "concept",
      "title": "なぜ起きる？",
      "body": "都合の良い情報は採用し、不都合な情報は別の理由で片づけてしまう",
      "visual_intent": "simple_diagram: ○都合の良い情報→採用 ×都合の悪い情報→言い訳して無視 / core_message: 都合の良い情報は採用し、不都合な情報は別の理由で片づけてしまう",
      "simple_diagram": "○都合の良い情報→採用 ×都合の悪い情報→言い訳して無視"
    },
    {
      "slide_id": "slide_03",
      "role": "example",
      "title": "恋愛での例",
      "body": "挨拶は脈アリ、断られた理由は偶然だと考えてしまう",
      "visual_intent": "simple_diagram: 挨拶→『好き！』 誘いを断られる→『たまたま！』 / core_message: 挨拶は脈アリ、断られた理由は偶然だと考えてしまう",
      "simple_diagram": "挨拶→『好き！』 誘いを断られる→『たまたま！』"
    }
  ],
