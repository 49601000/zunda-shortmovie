{
  "project_id": "0003",
  "source": "raw_conversation-v03.txt",
  "scenes": [
    {
      "scene_id": "scene_001",
      "slide_id": "slide_01",
      "speaker": "ずんだもん",
      "text": "『優しいけど傷つきやすい性格です』……完全にボクなのだ！",
      "emotion": "excited",
      "duration_sec": 4.52
    },
    {
      "scene_id": "scene_002",
      "slide_id": "slide_01",
      "speaker": "めたん",
      "text": "その手の文章を見て『自分のことだ！』って思う現象を、バーナム効果って言うのよ",
      "emotion": "excited",
      "duration_sec": 6
    },
    {
      "scene_id": "scene_003",
      "slide_id": "slide_01",
      "speaker": "ずんだもん",
      "text": "でも当たってるのだ！",
      "emotion": "excited",
      "duration_sec": 1.61
    },
    {
      "scene_id": "scene_004",
      "slide_id": "slide_02",
      "speaker": "めたん",
      "text": "その文章、たぶん100人読んだら80人くらい『私のことだ』って思うわよ",
      "emotion": "neutral",
      "duration_sec": 5.65
    },
    {
      "scene_id": "scene_005",
      "slide_id": "slide_02",
      "speaker": "ずんだもん",
      "text": "じゃあ『本当は天才なのに環境に恵まれていない』ってやつはどうなのだ！ボクそのものなのだ！",
      "emotion": "excited",
      "duration_sec": 6
    },
    {
      "scene_id": "scene_006",
      "slide_id": "slide_02",
      "speaker": "めたん",
      "text": "ただの現実逃避と、都合のいい自己正当化よ。急に知性が消えたわね",
      "emotion": "neutral",
      "duration_sec": 5
    },
    {
      "scene_id": "scene_007",
      "slide_id": "slide_03",
      "speaker": "ずんだもん",
      "text": "現実は嫌なのだ！ とりあえず未来の大成功への先行投資として、今日のランチ代を奢るのだ！",
      "emotion": "excited",
      "duration_sec": 6
    },
    {
      "scene_id": "scene_008",
      "slide_id": "slide_03",
      "speaker": "めたん",
      "text": "ただのタカりを自己啓発風に言い換えないで",
      "emotion": "neutral",
      "duration_sec": 3.23
    }
  ]
}
