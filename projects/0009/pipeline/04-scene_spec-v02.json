  "scenes": [
    {
      "scene_id": "scene_001",
      "slide_id": "slide_01",
      "speaker": "ずんだもん",
      "text": "ボクは奇跡の生還を果たした勇者なのだ！",
      "emotion": "excited",
      "duration_sec": 3.06
    },
    {
      "scene_id": "scene_002",
      "slide_id": "slide_01",
      "speaker": "めたん",
      "text": "で今日の収支はどうだったのよ",
      "emotion": "neutral",
      "duration_sec": 2.26
    },
    {
      "scene_id": "scene_003",
      "slide_id": "slide_01",
      "speaker": "ずんだもん",
      "text": "マイナス9万円からの奇跡の連チャンで7万円まくったのだ！ つまり……ほぼ勝ちなのだ！",
      "emotion": "excited",
      "duration_sec": 6
    },
    {
      "scene_id": "scene_004",
      "slide_id": "slide_02",
      "speaker": "めたん",
      "text": "普通に2万円負けよ",
      "emotion": "neutral",
      "duration_sec": 1.6
    },
    {
      "scene_id": "scene_005",
      "slide_id": "slide_02",
      "speaker": "ずんだもん",
      "text": "でも、マイナス9万から見たら7万円勝ってるのだ！",
      "emotion": "excited",
      "duration_sec": 3.87
    },
    {
      "scene_id": "scene_006",
      "slide_id": "slide_02",
      "speaker": "めたん",
      "text": "その“マイナス9万から見たら”が罠なのよ。最初の数字が基準になって判断がズレる。これがアンカリング効果ね",
      "emotion": "neutral",
      "duration_sec": 6
    },
    {
      "scene_id": "scene_007",
      "slide_id": "slide_03",
      "speaker": "ずんだもん",
      "text": "でも心は勝ってるのだ！ だから焼き肉で祝勝会なのだ！",
      "emotion": "excited",
      "duration_sec": 4.19
    },
    {
      "scene_id": "scene_008",
      "slide_id": "slide_03",
      "speaker": "めたん",
      "text": "気持ちで勝っても、お財布の中は負けてるわよ",
      "emotion": "neutral",
      "duration_sec": 3.39
    }
  ]
}
