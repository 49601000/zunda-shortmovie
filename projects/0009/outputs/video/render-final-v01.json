    },
    {
      "slide_id": "slide_02",
      "role": "concept",
      "title": "なぜ起きる？",
      "body": "最初の数字に引っぱられて、本当の結果を見失う",
      "visual_intent": "simple_diagram: -9万円（基準）→ +7万円戻す → 『勝った気分』 ／ 実際→ -2万円 / core_message: 最初の数字に引っぱられて、本当の結果を見失う",
      "simple_diagram": "-9万円（基準）→ +7万円戻す → 『勝った気分』 ／ 実際→ -2万円"
    },
    {
      "slide_id": "slide_03",
      "role": "example",
      "title": "ギャンブルでの例",
      "body": "『9万円負けから7万円戻した』と考えると、2万円負けでも勝った気分になる",
      "visual_intent": "simple_diagram: 収支 -2万円 ← 実際 ／ 気持ち『ほぼ勝ち！』 / core_message: 『9万円負けから7万円戻した』と考えると、2万円負けでも勝った気分になる",
      "simple_diagram": "収支 -2万円 ← 実際 ／ 気持ち『ほぼ勝ち！』"
    }
  ],
